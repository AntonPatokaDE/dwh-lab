# PostgreSQL source (container DNS names inside dwh-net)
DWH_NETWORK_NAME=dwh-net
SOURCE_HOST=postgres-source
SOURCE_PORT=5432
SOURCE_DB=adventureworks
SRC_USER=postgres
SRC_PASSWORD=postgres

# Greenplum
GP_HOST=gp-master
GP_PORT=5432
GP_DB=dwh
GP_USER=gpadmin
GP_PASSWORD=gparray

# Airflow development settings
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW__CORE__FERNET_KEY=

READ_PARTITIONS=1
WRITE_PARTITIONS=6
